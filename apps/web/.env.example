# Supabase — Project Settings → API (PRD §62)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the client bundle. Unused in Milestone 1.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Workspace Models (server-only; NEVER prefix these with NEXT_PUBLIC_) ---
# Provider credentials the workspace itself pays for. Present = that provider
# is offered on the workspace plan; absent = users are told workspace models
# are unavailable and can still connect their own API key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Requests per user per UTC day against workspace credentials (default 50).
# Bring-Your-Own-API turns are not counted — those spend the user's own quota.
WORKSPACE_DAILY_REQUEST_LIMIT=

# Dev only: allow simulated replies when no provider is configured.
# NEXT_PUBLIC_UAW_ENABLE_MOCK_PROVIDERS=true
